---
import Icon from '../../components/Icon.jsx';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero';
import StudioPass from '../../components/StudioPass';
import LabsGateway from '../../components/LabsGateway';
import WorkCard from '../../components/WorkCard.astro';
import ProjectStack from '../../components/ProjectStack';
import Contact from '../../components/Contact.astro';
import {paths,href,entryHref,t,projects,latestProjects,labs,serviceData} from '../../data.js';
export function getStaticPaths(){
 return ['es','en'].flatMap(lang=>[
  ...Object.entries(paths[lang]).map(([key,path])=>({params:{lang,page:path||undefined},props:{key}})),
  ...[['projects',projects],['labs',labs]].flatMap(([type,items])=>items.map(entry=>({params:{lang,page:`${paths[lang][type]}/${entry.slug}`},props:{key:'entry',type,entry}})))
 ]);
}
const {lang}=Astro.params;const {key,type,entry}=Astro.props;const other=lang==='es'?'en':'es';
const names={home:t(lang,'Branding, desarrollo web e inteligencia artificial','Branding, web development & AI'),projects:t(lang,'Proyectos de branding y diseño web','Branding and web design projects'),services:t(lang,'Servicios de diseño y desarrollo','Design and development services'),labs:'Labs — '+t(lang,'Aplicaciones e influencers con IA','AI apps and virtual influencers'),studio:t(lang,'El estudio','The studio'),contact:t(lang,'Contanos tu proyecto','Tell us about your project'),branding:'Branding',web:t(lang,'Diseño y desarrollo web','Web design & development'),ai:t(lang,'Soluciones con inteligencia artificial','Artificial intelligence projects')};
const descriptions={home:t(lang,'Bralipo es un estudio digital de Argentina. Identidades visuales, diseño y desarrollo web, aplicaciones y personajes virtuales con IA.','Bralipo is a digital studio based in Argentina. Visual identities, web design and development, AI apps and virtual characters.'),projects:t(lang,'Explorá el portfolio de Bralipo: identidades visuales y sitios web, con el contexto y alcance de cada proyecto.','Explore Bralipo’s portfolio of visual identities and websites, with the context and scope of each project.'),services:t(lang,'Branding, sitios web y proyectos con IA. Conocé los servicios de Bralipo y contanos qué querés crear.','Branding, websites and AI projects. Explore Bralipo’s services and tell us what you want to create.'),labs:t(lang,'Aplicaciones, influencers virtuales y experimentos propios de Bralipo. Conocé ¿Qué como?, aelia.afterdark y _notminjun.','Independent Bralipo apps, virtual influencers and experiments. Discover ¿Qué como?, aelia.afterdark and _notminjun.'),studio:t(lang,'Conocé Bralipo, el estudio digital de Brian en Argentina, y su manera de conectar diseño y tecnología.','Meet Bralipo, Brian’s digital studio in Argentina, connecting design and technology.'),contact:t(lang,'Contanos sobre tu proyecto de branding, web o IA. Contactá a Bralipo por formulario o en bralipo2@gmail.com.','Tell us about your branding, web or AI project. Contact Bralipo using the form or at bralipo2@gmail.com.')};
const title=entry?entry[lang].seoTitle:names[key];
const description=entry?entry[lang].seoDescription:descriptions[key]||serviceData[key]?.[lang][1];
const otherPath=entry?entryHref(other,type,entry.slug):href(other,key);
const ListingHeading=key==='labs'?'h2':'h1';
const serviceName=k=>k==='branding'?'Branding':k==='web'?t(lang,'Diseño & desarrollo web','Web design & development'):t(lang,'Creación con IA','Creating with AI');
---
<Layout lang={lang} title={title} description={description} otherPath={otherPath} demo={entry?.demo} image={entry?.cover?.endsWith('.svg')?undefined:entry?.cover}>
 {key==='home'&&<>
  <Hero lang={lang} client:load/>
  <section id="selected-work" class="section light work-section"><div class="section-heading"><div><p class="eyebrow">01 / {t(lang,'ÚLTIMOS PROYECTOS','LATEST PROJECTS')}</p><h2>{t(lang,'Trabajo con','Work with')} <em>{t(lang,'carácter.','character.')}</em></h2></div></div><ProjectStack entries={latestProjects} lang={lang} client:load/>{!projects.length&&<p>{t(lang,'Estamos preparando nuestros próximos casos. Mientras tanto, explorá Labs.','Our next case studies are on their way. In the meantime, explore Labs.')}</p>}<div class="work-section-footer"><a class="button" href={href(lang,'projects')}>{t(lang,'Todos los proyectos','All projects')} <span><Icon name="arrow-up-right"/></span></a></div></section>
  <section id="what-we-do" class="section services-section"><div class="services-art" aria-hidden="true"><img src="/images/recurso2.webp" width="940" height="986" alt="" loading="lazy" class="angular-art"/></div><div class="service-intro"><p class="eyebrow">02 / {t(lang,'LO QUE HACEMOS','WHAT WE DO')}</p><h2>{t(lang,'De tu primera idea','From your first idea')}<br/><em>{t(lang,'a lo que sigue.','to what comes next.')}</em></h2><p>{t(lang,'Una marca, una web o algo que todavía no existe. Encontramos la forma de hacerlo realidad.','A brand, a website, or something that does not exist yet. We find a way to bring it to life.')}</p></div><div class="service-rows">{['branding','web','ai'].map((k,i)=><a class="service-row" href={href(lang,k)}><span class="index">0{i+1}</span><div><h3>{serviceName(k)}</h3><p>{serviceData[k][lang][1]}</p></div><span class="row-arrow"><Icon name="arrow-up-right"/></span></a>)}</div></section>
  <LabsGateway lang={lang} client:visible/>
  <section class="section light process-section"><p class="eyebrow">04 / {t(lang,'EL PROCESO','THE PROCESS')}</p><div class="section-heading"><h2>{t(lang,'Buenas ideas.','Good ideas.')}<br/><em>{t(lang,'Pasos claros.','Clear steps.')}</em></h2><p class="section-aside">{t(lang,'Trabajamos con vos desde la primera conversación hasta el último detalle.','We work with you from the first conversation to the final detail.')}</p></div><div class="process-grid">{(lang==='es'?[['Escuchamos','Entendemos tu idea, tus necesidades y el contexto del proyecto.'],['Definimos','Acordamos alcance, entregables y una dirección para avanzar.'],['Creamos','Diseñamos, desarrollamos y ajustamos la propuesta con vos.'],['Entregamos','Preparamos los archivos, el sitio o el producto para su siguiente etapa.']]:[['Listen','We understand your idea, your needs and the context.'],['Define','We agree on scope, deliverables and a direction.'],['Create','We design, build and refine the proposal with you.'],['Deliver','We prepare the files, website or product for its next stage.']]).map(([name,body],i)=><div><span class="index">0{i+1}</span><h3>{name}</h3><p>{body}</p></div>)}</div></section>
 </>}
 {key==='labs'&&<LabsGateway lang={lang} page client:load/>}
 {['projects','labs'].includes(key)&&<section id={key==='labs'?'lab-experiments':undefined} class:list={['section','listing-section',key==='projects'?'light':'labs-section']}><p class="eyebrow">{key==='labs'?'BRALIPO LABS':t(lang,'NUESTRO TRABAJO','OUR WORK')}</p><ListingHeading>{key==='projects'?t(lang,'Trabajo con','Work with'):t(lang,'El laboratorio','The lab')}<br/><em>{key==='projects'?t(lang,'carácter.','character.'):t(lang,'en acción.','in action.')}</em></ListingHeading><p class="intro-text">{key==='projects'?t(lang,'Cada proyecto tiene su propia historia. Identidades y experiencias digitales que toman forma.','Every project has its own story. Identities and digital experiences taking shape.'):descriptions.labs}</p><div class="filters" aria-label={t(lang,'Filtrar proyectos','Filter projects')}>{(key==='projects'?[['all',t(lang,'Todos','All')],['branding','Branding'],['web','Web']]:[['all',t(lang,'Todos','All')],['apps',t(lang,'Aplicaciones','Apps')],['influencers',t(lang,'Influencers virtuales','Virtual influencers')]]).map(([value,label],i)=><button data-filter={value} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div><div class:list={[key==='projects'?'work-grid':'labs-grid']}>{(key==='projects'?projects:labs).map(entry=><WorkCard entry={entry} lang={lang} type={key} heading={key==='labs'?'h3':'h2'}/>)}</div></section>}
 {key==='services'&&<section class="section"><p class="eyebrow">{t(lang,'SERVICIOS','SERVICES')}</p><h1>{t(lang,'Diseño y tecnología','Design and technology')}<br/><em>{t(lang,'para tu proyecto.','for your project.')}</em></h1><p class="intro-text">{t(lang,'Una nueva marca, una web o una idea que querés desarrollar. Encontramos el punto de partida y definimos con vos qué hace falta para llevarla adelante.','A new brand, a website or an idea you want to develop. We find the starting point and define what it takes to move forward.')}</p><div class="service-rows full">{['branding','web','ai'].map((k,i)=><a class="service-row" href={href(lang,k)}><span class="index">0{i+1}</span><div><h2>{serviceName(k)}</h2><p>{serviceData[k][lang][1]}</p></div><span class="row-arrow"><Icon name="arrow-up-right"/></span></a>)}</div></section>}
 {['branding','web','ai'].includes(key)&&<section class="section service-detail"><a class="back-link" href={href(lang,'services')}><Icon name="arrow-left"/> {t(lang,'Servicios','Services')}</a><p class="eyebrow">{serviceName(key)}</p><h1>{serviceData[key][lang][0]}</h1><div class="detail-grid"><p class="intro-text">{serviceData[key][lang][1]}</p><ul class="deliverables">{serviceData[key][lang][2].map(item=><li>{item}<span><Icon name="arrow-up-right"/></span></li>)}</ul></div><p class="muted">{t(lang,'El alcance y los entregables se definen según las necesidades de cada proyecto.','Scope and deliverables are defined around each project’s needs.')}</p><a class="text-link" href={href(lang,key==='ai'?'labs':'projects')}>{t(lang,'Explorá el trabajo','Explore the work')} <Icon name="arrow-up-right"/></a></section>}
 {key==='studio'&&<section class="section studio-section"><div class="studio-background" aria-hidden="true"><img src="/images/recurso3.webp" width="498" height="461" alt=""/></div><p class="eyebrow">{t(lang,'EL ESTUDIO','THE STUDIO')}</p><h1>{t(lang,'Detrás de cada idea,','Behind every idea,')}<br/><em>{t(lang,'una mirada propia.','a distinct perspective.')}</em></h1><div class="detail-grid"><div><h2>{t(lang,'Soy Brian.','I’m Brian.')}</h2>
 <p class="intro-text">{t(lang,'Soy de Argentina y empecé a diseñar a los 14 años. Me pasaba las madrugadas aprendiendo, probando y creando en Photoshop.','I’m from Argentina, and I started designing at 14. I spent late nights learning, experimenting and creating in Photoshop.')}</p>
 <p>{t(lang,'Después llegó Dreamweaver y, con él, mis primeras líneas de código. Diseñaba y desarrollaba fansites: blogs de WordPress que los fans dedicaban a sus artistas favoritos. Fueron mis primeros trabajos pagos y el impulso para seguir aprendiendo.','Then came Dreamweaver and my first lines of code. I designed and built fansites: WordPress blogs dedicated to fans’ favourite artists. They became my first paid projects and gave me a reason to keep learning.')}</p>
 <p>{t(lang,'De esos sitios pasé a otros proyectos de diseño y desarrollo web. En el camino descubrí cuánto me gustaba crear marcas: cómo se ven, cómo se expresan y cómo venden. Esa curiosidad también me llevó a estudiar marketing digital.','Those sites led to other design and web development projects. Along the way, I discovered how much I enjoyed creating brands: how they look, how they express themselves and how they sell. That curiosity also led me to study digital marketing.')}</p>
 <p>{t(lang,'Con la IA encontré nuevas formas de llevar ideas a la práctica y explorar cosas que antes no sabía hacer. Hoy experimento con aplicaciones, influencers virtuales y proyectos creativos que comparto en Labs.','AI opened up new ways to bring ideas to life and explore things I hadn’t known how to do before. Today, I experiment with apps, virtual influencers and creative projects that I share in Labs.')}</p>
 <p>{t(lang,'Bralipo reúne ese recorrido: diseño, desarrollo y curiosidad por lo que viene. Esa es la mirada que llevo a cada proyecto.','Bralipo brings that journey together: design, development and curiosity about what comes next. That’s the perspective I bring to every project.')}</p>
 <a class="text-link" href={href(lang,'labs')}>{t(lang,'Conocé mis exploraciones','Explore my experiments')} <Icon name="arrow-up-right"/></a></div><StudioPass lang={lang} client:visible/></div></section>}
 {key==='contact'&&<section class="section"><Contact lang={lang}/></section>}
 {key==='entry'&&<article class="case-page"><section class="section case-heading"><a class="back-link" href={href(lang,type)}><Icon name="arrow-left"/> {type==='labs'?'Labs':t(lang,'Proyectos','Projects')}</a><p class="eyebrow">{entry[lang].scope}</p><h1>{entry.title}</h1><p class="intro-text">{entry[lang].summary}</p>{entry.demo&&<p class="sample-notice">{t(lang,'Contenido de demostración. Las imágenes y los detalles se reemplazarán por un proyecto real.','Demonstration content. Images and details will be replaced with a real project.')}</p>}</section><figure class="case-cover"><img src={entry.cover} alt={entry[lang].alt} width="1200" height="900" fetchpriority="high"/><figcaption>{entry[lang].alt}</figcaption></figure><section class="section detail-grid"><div><p class="eyebrow">{t(lang,'SOBRE EL PROYECTO','ABOUT THE PROJECT')}</p><h2>{t(lang,'La idea toma','The idea takes')} <em>{t(lang,'forma.','shape.')}</em></h2></div><div class="case-copy">{entry[lang].description.split('\n\n').map(p=><p>{p}</p>)}<dl><dt>{t(lang,'Participación','Role')}</dt><dd>{entry[lang].role}</dd><dt>{t(lang,'Áreas','Areas')}</dt><dd>{entry[lang].scope}</dd></dl>{entry.external&&<a class="button" href={entry.external} target="_blank" rel="noopener noreferrer">{entry.category==='apps'?t(lang,'Probar la app','Try the app'):'Instagram'} <span><Icon name="arrow-up-right"/></span></a>}</div></section>{entry.gallery?.length>0&&<div class="section gallery">{entry.gallery.map(item=><figure><img src={item.image} alt={item[lang]?.alt||''} width="1200" height="900" loading="lazy"/><figcaption>{item[lang]?.caption}</figcaption></figure>)}</div>}</article>}
 {key!=='contact'&&<section class="contact-band"><div><p class="eyebrow">{t(lang,'¿TENÉS ALGO EN MENTE?','HAVE SOMETHING IN MIND?')}</p><h2>{t(lang,'Hagamos algo','Let’s create')}<br/><em>{t(lang,'con carácter.','with character.')}</em></h2></div><a class="round-cta" href={href(lang,'contact')} aria-label={t(lang,'Contanos tu proyecto','Tell us about your project')}><Icon name="arrow-up-right"/></a><a class="contact-email" href="mailto:bralipo2@gmail.com">bralipo2@gmail.com</a></section>}
</Layout>
