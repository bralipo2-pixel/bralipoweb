# Valores públicos de configuración, nunca secretos OAuth.
# Netlify obtiene el repositorio desde REPOSITORY_URL al conectar GitHub.
# Usar CMS_GITHUB_REPO solo si hace falta indicar otro repositorio explícito.
CMS_GITHUB_REPO=
CMS_BRANCH=main
# Sin dominio propio, Netlify usa automáticamente su URL principal.
SITE_URL=
# Mantener false hasta revisar el contenido y confirmar el dominio.
PUBLIC_INDEXABLE=false
# En Netlify se activa en el contexto production desde netlify.toml.
PUBLIC_FORM_ENABLED=false
